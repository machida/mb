<section class="l--archive-page l--archive-year" aria-labelledby="archive-year-title">
  <header class="l--archive-header mb-8">
    <h1 id="archive-year-title" class="l--archive-header__title text-3xl font-bold mb-2 spec--archive-year-title"><%= @year %>年の記事</h1>
    <% unless @articles.empty? %>
      <p class="l--archive-header__count"><%= @articles.count %>件の記事があります</p>
    <% end %>
  </header>

  <!-- 月別ナビゲーション -->
  <section class="l--archive-months" aria-labelledby="archive-months-title">
    <h2 id="archive-months-title" class="l--archive-months__title text-xl font-semibold">月別アーカイブ</h2>
    <div class="l--archive-months__grid grid grid-cols-3 md:grid-cols-6 gap-3">
      <% (1..12).each do |month| %>
        <% count = @monthly_counts[format("%02d", month)] || 0 %>
        <% if count > 0 %>
          <%= link_to archive_month_path(@year, month), class: "l--archive-months__item flex-col text-center" do %>
            <%= month %>月<br>
            <span class="l--archive-months__count text-sm">(<%= count %>)</span>
          <% end %>
        <% else %>
          <div class="l--archive-months__item is--empty flex flex-col bg-gray-200 text-gray-500 px-3 py-2 rounded text-center">
            <%= month %>月<br>
            <span class="l--archive-months__count text-sm">(0)</span>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>

  <!-- 記事一覧 -->
  <section class="l--articles-list" aria-label="<%= @year %>年の記事一覧">
    <%= render partial: "article_item", collection: @articles %>
  </section>

  <% if @articles.empty? %>
    <div class="l--archive-empty text-center py-12">
      <p class="l--archive-empty__message text-gray-500 text-lg"><%= @year %>年の記事はまだありません</p>
    </div>
  <% end %>

  <!-- Pagination -->
  <% if @articles.respond_to?(:total_pages) && @articles.total_pages > 1 %>
    <nav class="l--archive-pagination mt-8 flex justify-center spec--pagination" aria-label="記事ページネーション">
      <%= paginate @articles %>
    </nav>
  <% end %>

  <!-- ナビゲーション -->
  <nav class="l--archive-back-navigation mt-8 text-center" aria-label="トップページへ戻る">
    <%= link_to root_path, class: "l--archive-back-navigation__link" do %>
      <span class="l--archive-back-navigation__icon material-symbols-outlined" aria-hidden="true">home</span>
      <span class="l--archive-back-navigation__label">HOME</span>
    <% end %>
  </nav>
</section>

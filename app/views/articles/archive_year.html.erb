<section class="l--archive-page l--archive-year" aria-labelledby="archive-year-title">
  <header class="l--archive-header">
    <h1 id="archive-year-title" class="l--archive-header__title spec--archive-year-title"><%= @year %>年</h1>
  </header>

  <!-- 月別ナビゲーション -->
  <section class="l--archive-months" aria-label="月別アーカイブ">
    <div class="l--archive-months__grid">
      <% (1..12).each do |month| %>
        <% count = @monthly_counts[format("%02d", month)] || 0 %>
        <% month_in_future = Date.new(@year, month, 1) > Date.current.beginning_of_month %>
        <% month_content = capture do %>
          <span class="l--archive-months__month"><%= month %>月</span>
          <span class="l--archive-months__count">(<%= count %>)</span>
        <% end %>
        <% if count > 0 && !month_in_future %>
          <%= link_to month_content, archive_month_path(@year, month), class: "l--archive-months__item" %>
        <% else %>
          <div class="l--archive-months__item<%= " is--empty" if count.zero? %><%= " is--future" if month_in_future %>">
            <%= month_content %>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>

  <!-- 記事一覧 -->
  <section class="l--articles-list" aria-label="<%= @year %>年の記事一覧">
    <%= render partial: "article_item", collection: @articles %>
  </section>

  <% if @articles.empty? %>
    <div class="l--archive-empty">
      <p class="l--archive-empty__message"><%= @year %>年の記事はまだありません</p>
    </div>
  <% end %>

  <!-- Pagination -->
  <% if @articles.respond_to?(:total_pages) && @articles.total_pages > 1 %>
    <nav class="l--archive-pagination spec--pagination" aria-label="記事ページネーション">
      <%= paginate @articles %>
    </nav>
  <% end %>

  <!-- ナビゲーション -->
  <nav class="l--archive-back-navigation" aria-label="トップページへ戻る">
    <%= link_to root_path, class: "l--archive-back-navigation__link" do %>
      <span class="l--archive-back-navigation__icon material-symbols-outlined" aria-hidden="true">home</span>
      <span class="l--archive-back-navigation__label">HOME</span>
    <% end %>
  </nav>
</section>

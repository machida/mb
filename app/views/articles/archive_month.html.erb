<section class="l--archive-page l--archive-month" aria-labelledby="archive-month-title">
  <!-- ナビゲーション -->
  <nav class="l--archive-month-navigation mb-12" aria-label="月別アーカイブ間の移動">
    <% if @month > 1 %>
      <%= link_to archive_month_path(@year, @month - 1), class: "l--archive-month-navigation__link is--previous" do %>
        <span class="l--archive-month-navigation__icon material-symbols-outlined" aria-hidden="true">chevron_left</span>
        <span class="l--archive-month-navigation__label"><%= @month - 1 %>月</span>
      <% end %>
    <% end %>

    <%= link_to archive_year_path(@year), class: "l--archive-month-navigation__link is--year" do %>
      <span class="l--archive-month-navigation__label"><%= @year %>年</span>
    <% end %>

    <% if @month < 12 %>
      <%= link_to archive_month_path(@year, @month + 1), class: "l--archive-month-navigation__link is--next" do %>
        <span class="l--archive-month-navigation__label"><%= @month + 1 %>月</span>
        <span class="l--archive-month-navigation__icon material-symbols-outlined" aria-hidden="true">chevron_right</span>
      <% end %>
    <% end %>
  </nav>

  <header class="l--archive-header mb-8">
    <h1 id="archive-month-title" class="l--archive-header__title text-3xl font-bold mb-2 spec--archive-month-title"><%= @year %>年<%= @month %>月</h1>
  </header>

  <% unless @articles.empty? %>
    <p class="l--archive-header__count"><%= @articles.count %>件の記事があります</p>
  <% end %>

  <!-- 記事一覧 -->
  <section class="l--articles-list" aria-label="<%= @year %>年<%= @month %>月の記事一覧">
    <%= render partial: "article_item", collection: @articles %>
  </section>

  <% if @articles.empty? %>
    <div class="l--archive-empty text-center py-12">
      <p class="l--archive-empty__message text-lg"><%= @year %>年<%= @month %>月の記事はまだありません</p>
    </div>
  <% end %>

  <!-- Pagination -->
  <% if @articles.respond_to?(:total_pages) && @articles.total_pages > 1 %>
    <nav class="l--archive-pagination mt-8 flex justify-center spec--pagination" aria-label="記事ページネーション">
      <%= paginate @articles %>
    </nav>
  <% end %>

  <!-- ナビゲーション -->
  <nav class="l--archive-back-navigation" aria-label="トップページへ戻る">
    <%= link_to root_path, class: "l--archive-back-navigation__link" do %>
      <span class="l--archive-back-navigation__icon material-symbols-outlined" aria-hidden="true">home</span>
      <span class="l--archive-back-navigation__label">HOME</span>
    <% end %>
  </nav>
</section>

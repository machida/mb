<div class="l--archive-page l--archive-month">
  <header class="l--archive-header mb-8">
    <h1 class="l--archive-header__title text-3xl font-bold mb-2 spec--archive-month-title"><%= @year %>年<%= @month %>月の記事</h1>
    <% unless @articles.empty? %>
      <p class="l--archive-header__count"><%= @articles.count %>件の記事があります</p>
    <% end %>
  </header>

  <!-- ナビゲーション -->
  <nav class="l--archive-month-navigation mb-12 flex justify-center gap-12" aria-label="月別アーカイブ間の移動">
    <% if @month > 1 %>
      <%= link_to archive_month_path(@year, @month - 1), class: "a--button is--md is--secondary" do %>
        <span class="material-symbols-outlined">chevron_left</span>
        <%= @month - 1 %>月
      <% end %>
    <% end %>

    <%= link_to archive_year_path(@year), class: "a--button is--md is--primary" do %>
      <%= @year %>年の一覧
    <% end %>

    <% if @month < 12 %>
      <%= link_to archive_month_path(@year, @month + 1), class: "a--button is--md is--secondary" do %>
        <%= @month + 1 %>月
        <span class="material-symbols-outlined">chevron_right</span>
      <% end %>
    <% end %>
  </nav>

  <!-- 記事一覧 -->
  <div class="l--articles-list">
    <%= render partial: "article_item", collection: @articles %>
  </div>

  <% if @articles.empty? %>
    <div class="l--archive-empty text-center py-12">
      <p class="l--archive-empty__message text-lg"><%= @year %>年<%= @month %>月の記事はまだありません</p>
    </div>
  <% end %>

  <!-- Pagination -->
  <div class="l--archive-pagination mt-8 flex justify-center spec--pagination">
    <%= paginate @articles %>
  </div>

  <!-- ナビゲーション -->
  <nav class="l--archive-back-navigation mt-8 text-center" aria-label="トップページへ戻る">
    <%= link_to root_path, class: "l--archive-back-navigation__link" do %>
      <span class="l--archive-back-navigation__icon material-symbols-outlined" aria-hidden="true">home</span>
      <span class="l--archive-back-navigation__label">HOME</span>
    <% end %>
  </nav>
</div>

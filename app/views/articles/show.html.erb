<% content_for :head do %>
  <% if @article.draft? %>
    <meta name="robots" content="noindex, nofollow">
  <% end %>
  <% if @article.summary.present? %>
    <meta name="description" content="<%= @article.summary %>">
    <meta property="og:description" content="<%= @article.summary %>">
  <% end %>
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:type" content="article">
  <meta property="og:title" content="<%= @article.title %>">
  <meta property="og:site_name" content="<%= SiteSetting.site_title %>">
  <% og_image_url = @article.og_image_url %>
  <% if og_image_url.present? %>
    <meta property="og:image" content="<%= og_image_url %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
  <% end %>
<% end %>

<div class="l--article-page">
  <article class="l--article-main">
  <% if @article.thumbnail.present? %>
    <%= image_tag @article.thumbnail, alt: "", class: "l--article-main__image" %>
  <% end %>

  <header class="l--article-header">
    <time datetime="<%= @article.created_at.iso8601 %>" class="l--article-header__date">
      <%= link_to @article.created_at.strftime("%Y-%m-%d"),
                  archive_month_path(@article.created_at.year, @article.created_at.month),
                  class: "spec--article-date" %>
    </time>
    <h1 class="l--article-header__title spec--article-title"><%= @article.title %></h1>
    <% if show_author_info? %>
      <div class="l--article-header__meta">
        <span class="l--article-header__author spec--article-author">著者: <%= @article.author %></span>
      </div>
    <% end %>
  </header>

  <% if @article.draft? %>
    <aside class="l--article-draft-notice a--card is--warning spec--draft-notice mb-6">
      <h2 class="l--article-draft-notice__title flex items-center gap-1 text-lg font-semibold mb-2">
        <span class="l--article-draft-notice__icon material-symbols-outlined text-amber-600" style="font-size: 1.25rem;">warning</span>
        この記事は下書きです
      </h2>
      <p class="l--article-draft-notice__message text-sm">この記事は現在下書き状態で、一般には公開されていません。</p>
    </aside>
  <% end %>

  <div class="a--long-text spec--article-content">
    <%= markdown(@article.body) %>
  </div>

<nav class="l--article-navigation" aria-label="前後の記事">
  <div class="l--article-navigation__previous">
    <% if @previous_article.present? %>
      <%= link_to article_path(@previous_article), class: "l--article-navigation__link spec--previous-article-link", aria: { label: "前の記事" } do %>
        <span class="l--article-navigation__icon material-symbols-outlined" aria-hidden="true">chevron_left</span>
        <span class="l--article-navigation__label">PREV</span>
      <% end %>
    <% end %>
  </div>
  <%= link_to "NOTE", root_path, class: "sr-only spec--back-to-articles-link" %>
  <div class="l--article-navigation__next">
    <% if @next_article.present? %>
      <%= link_to article_path(@next_article), class: "l--article-navigation__link spec--next-article-link", aria: { label: "次の記事" } do %>
        <span class="l--article-navigation__label">NEXT</span>
        <span class="l--article-navigation__icon material-symbols-outlined" aria-hidden="true">chevron_right</span>
      <% end %>
    <% end %>
  </div>
</nav>

<% if current_user_signed_in? %>
  <nav class="l--article-admin-actions mt-4 flex gap-2" aria-label="記事管理">
    <%= link_to "編集", edit_admin_article_path(@article), class: "l--article-admin-actions__edit a--button is--md is--secondary" %>
    <%= link_to "削除", admin_article_path(@article), method: :delete,
                data: { confirm: "この記事を削除しますか？削除すると元に戻せません。" },
                class: "l--article-admin-actions__delete a--button is--md is--border-danger spec--delete-article-button" %>
  </nav>
<% end %>
  </article>

</div>

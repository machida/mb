<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "マチダのブログ" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= content_for(:description) || SiteSetting.top_page_description %>">
    <meta property="og:title" content="<%= content_for(:title) || "マチダのブログ" %>">
    <meta property="og:description" content="<%= content_for(:description) || SiteSetting.top_page_description %>">
    <meta property="og:site_name" content="マチダのブログ">
    <% default_og_image_url = SiteSetting.default_og_image_url %>
    <% if default_og_image_url.present? %>
      <meta property="og:image" content="<%= default_og_image_url %>">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
    <% end %>
    <%= csrf_meta_tags %>
    <meta name="csrf-token" content="<%= form_authenticity_token %>" class="js-csrf-token">
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= render "shared/style_sheets" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="l--public-page min-h-screen flex flex-col layout-public">
    <%= render "public/header" %>
    <%= render "public/hero" if controller_name == "articles" && action_name == "index" %>

    <div class="l--public-body">
      <main class="l--public-main flex-1 l--container is--md">
        <%= yield %>
      </main>
    </div>

    <%= render "public/breadcrumbs" %>
    <%= render "public/footer" %>

    <!-- Toast Container -->
    <div id="toast-container" class="l--toast-container fixed top-4 right-4 z-50 flex flex-col gap-2 js--toast-container" role="status" aria-live="polite" aria-atomic="true">
      <%= render "shared/toasts" %>
    </div>
  </body>
</html>
